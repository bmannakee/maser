#!/bin/sh
# Runs the UI scenarios: each one in a fresh launch of a debug build, against a fake gh that replays recordings.
#
# Usage: scripts/check-ui [--record] [scenario…]   (default: every scenario in Sources/Maser/UIScenarios.swift)
#
# Each scenario takes over the keyboard and brings a window to the front for a few seconds, so leave the Mac alone
# while it runs. The app runs as a separate bundle (dev.maser.Maser.uitests) with its own settings, so it doesn't
# touch a Maser you're using. --record sends commands that have no recording to the real gh, read-only, and saves
# what it prints in Tests/UIScenarios/recordings. See Tests/UIScenarios/README.md.
set -eu

# Keep the display awake and the Mac from sleeping for the whole run, so the screen doesn't lock partway through.
# This can't unlock a screen that is already locked; the check below still stops in that case.
if [ -z "${MASER_CHECK_UI_AWAKE:-}" ]; then
    MASER_CHECK_UI_AWAKE=1 exec caffeinate -dimsu "$0" "$@"
fi

cd "$(dirname "$0")/.."

record=""
if [ "${1:-}" = "--record" ]; then
    record="$(command -v gh)" || { echo "--record needs gh on the PATH" >&2; exit 2; }
    shift
fi
scenarios="$*"
if [ -z "$scenarios" ]; then
    # The first quoted name after each `= UIScenario(`, on the same line or the next.
    scenarios="$(awk '/= UIScenario\(/ { want = 1 } want && match($0, /"[a-z0-9-]+"/) {
        print substr($0, RSTART + 1, RLENGTH - 2); want = 0 }' Sources/Maser/UIScenarios.swift)"
fi

# No app can become active while the screen is locked. The console session says so directly; the system-wide
# IOConsoleLocked flag can read false while the session is locked.
if ioreg -n Root -d1 | grep -q '"CGSSessionScreenIsLocked"=Yes'; then
    echo "The screen is locked; the UI scenarios need it unlocked." >&2
    exit 2
fi

echo "==> swift build"
swift build
bin="$(swift build --show-bin-path)"
app=".build/MaserUITests.app"
bundle_id="dev.maser.Maser.uitests"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$bin/Maser" "$app/Contents/MacOS/Maser"
cp "$bin/maser-agent-tools" "$app/Contents/MacOS/maser-agent-tools"
mkdir -p "$app/Contents/Resources"
cp Vendor/pele/pele.global.js "$app/Contents/Resources/pele.global.js"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>$bundle_id</string>
    <key>CFBundleName</key><string>Maser UI Tests</string>
    <key>CFBundleExecutable</key><string>Maser</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
codesign --force --sign - --timestamp=none "$app/Contents/MacOS/maser-agent-tools"
codesign --force --sign - --timestamp=none "$app"

work="$(mktemp -d "${TMPDIR:-/tmp}/maser-ui.XXXXXX")"
recordings="$PWD/Tests/UIScenarios/recordings"
# Launches the test app for one scenario and waits for it to exit, killing it after 120 s.
# Arguments: the scenario's name, and 1 if this is a relaunch after the scenario crashed the app.
launch() {
    open -n -W --stdout "$dir/log.txt" --stderr "$dir/log.txt" \
        --env XDG_CONFIG_HOME="$dir/config" --env MASER_UI_SCENARIO="$1" --env MASER_UI_RESULT="$dir/result" \
        --env MASER_UI_RELAUNCHED="$2" \
        --env FAKE_GH_DIR="$recordings" --env FAKE_GH_STATE="$dir/gh" --env FAKE_GH_RECORD="$record" \
        --env FAKE_GH_XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" \
        --env MASER_AGENT_CHECKOUT="$dir/checkout" --env FAKE_CLAUDE_LOG="$dir/claude.jsonl" \
        "$app" --args -ApplePersistenceIgnoreState YES &
    launcher=$!
    # macOS won't let the app bring itself forward while another app is frontmost, so ask for it here.
    sleep 2
    osascript -e "tell application id \"$bundle_id\" to activate" >/dev/null 2>&1 || true
    seconds=2
    while kill -0 "$launcher" 2>/dev/null; do
        sleep 1
        seconds=$((seconds + 1))
        if [ "$seconds" -ge 120 ]; then
            pkill -f "$app/Contents/MacOS/Maser" || true
            echo "timed out after 120 s" >> "$dir/result"
        fi
    done
}

passed=0
failed=""
for scenario in $scenarios; do
    dir="$work/$scenario"
    mkdir -p "$dir/config/maser" "$dir/gh"
    sed -e "s|@FAKE_GH@|$bin/fake-gh|" -e "s|@FAKE_CLAUDE@|$bin/fake-claude|" Tests/UIScenarios/config.toml \
        > "$dir/config/maser/config.toml"
    # The agent reads this folder instead of a checkout: the recorded PRs' commits can't be fetched without GitHub.
    # It holds the door controller the fake claude draws, and the file test PR #1 adds, for its citations.
    mkdir -p "$dir/checkout/Sources"
    cp Tests/UIScenarios/checkout/Door.swift "$dir/checkout/Sources/Door.swift"
    cp Tests/UIScenarios/checkout/COMMENT-TEST.md "$dir/checkout/COMMENT-TEST.md"
    # Start from nothing saved: no restored windows, sidebar widths or unsent text from an earlier run.
    defaults delete "$bundle_id" >/dev/null 2>&1 || true
    rm -rf "$HOME/Library/Saved Application State/$bundle_id.savedState" "$HOME/Library/Application Support/$bundle_id"

    launch "$scenario" 0
    # A scenario that crashes the app on purpose asks to be launched again, keeping what was saved.
    if [ "$(cat "$dir/result" 2>/dev/null)" = "RELAUNCH" ]; then
        rm -f "$dir/result"
        launch "$scenario" 1
    fi
    result="$(cat "$dir/result" 2>/dev/null || echo "FAIL: no result; the app crashed or quit (see its log)")"
    if [ "$result" = "PASS" ]; then
        echo "✔ $scenario"
        passed=$((passed + 1))
    else
        echo "✘ $scenario: $result"
        sed 's/^/    /' "$dir/log.txt" | grep -v "^    [0-9-]* [0-9:.]* Maser\[" | tail -25
        failed="$failed $scenario"
    fi
done

echo "$passed passed${failed:+, failed:$failed}. Logs and gh calls: $work"
[ -z "$failed" ]
